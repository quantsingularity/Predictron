# Copy to .env and fill in. Never commit the real .env, it's gitignored.

NODE_ENV="development"

# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/predictron"

# Chain RPC (read-only, the backend never signs a transaction)
RPC_URL="https://bsc-dataseed1.binance.org"
CHAIN_ID=56

# Deployed contract addresses (from `npm run deploy:mainnet` output in /contracts)
STAKING_VAULT_ADDRESS="0x0000000000000000000000000000000000000000"
PREDICTION_GAME_ADDRESS="0x0000000000000000000000000000000000000000"
REFERRAL_REGISTRY_ADDRESS="0x0000000000000000000000000000000000000000"
STAKING_VAULT_DEPLOY_BLOCK=0
PREDICTION_GAME_DEPLOY_BLOCK=0

# Blocks to stay behind the chain head before indexing, to absorb a shallow
# reorg. ~15 blocks is a few minutes on BSC.
INDEXER_CONFIRMATION_BLOCKS=15

# Session signing secret for SIWE-issued JWTs, 32+ random bytes, e.g.
# `openssl rand -hex 32`. This signs session tokens only, delivered as an
# httpOnly cookie; it can never move funds, there is no wallet key here.
SESSION_JWT_SECRET="change-me-to-a-real-random-secret"
SESSION_TTL_HOURS=24

# SIWE
SIWE_DOMAIN="app.predictron.example"
SIWE_URI="https://app.predictron.example"

CORS_ORIGIN="https://app.predictron.example"
PORT=4000
LOG_LEVEL="info"

# Optional, code/ai_services/inference_api. Leave unset to run without AI signals.
AI_SERVICE_URL="http://localhost:8000"
