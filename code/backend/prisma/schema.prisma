// This database is a read cache of on-chain events plus off-chain-only
// concerns (profile metadata, referral attribution, tickets, admin roles).
// It is never the source of truth for a balance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id              String     @id @default(cuid())
  address         String     @unique // checksummed EVM address, the only identity
  role            Role       @default(USER)
  referralCode    String     @unique
  referredById    String?
  referredBy      User?      @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]     @relation("Referrals")
  createdAt       DateTime   @default(now())

  stakes          IndexedStake[]
  bets            IndexedBet[]
  referralPayouts ReferralPayout[]
  tickets         Ticket[]
  nonces          AuthNonce[]

  @@index([referredById])
}

/// One row per SIWE login nonce, deleted on successful verify.
model AuthNonce {
  id          String   @id @default(cuid())
  userAddress String
  nonce       String   @unique
  expiresAt   DateTime
  user        User?    @relation(fields: [userAddress], references: [address])

  @@index([userAddress])
}

/// Mirrors StakingVault.Staked / Unstaked events.
model IndexedStake {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  chainPositionId BigInt
  planId          BigInt
  amount          String // wei-precision decimal string
  stakeTxHash     String    @unique
  unstakeTxHash   String?
  rewardPaid      String?
  status          String    @default("ACTIVE") // ACTIVE | UNSTAKED
  startBlock      BigInt
  unlockTimestamp DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
}

/// Mirrors PredictionGame.BetPlaced / Claimed events.
model IndexedBet {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  epoch       BigInt
  position    String // "UP" | "DOWN"
  amount      String
  betTxHash   String   @unique
  claimTxHash String?
  payout      String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([epoch])
}

/// Mirrors PredictionGame's ReferralRewardAccrued / ReferralRewardClaimed
/// events. One row per accrual; a referrer's total is the sum of their rows.
model ReferralPayout {
  id             String   @id @default(cuid())
  userId         String // the referrer who earns this reward
  user           User     @relation(fields: [userId], references: [id])
  referredUserId String? // the referred user whose winning claim triggered it
  epoch          BigInt?
  amount         String
  status         String   @default("ACCRUED") // ACCRUED | CLAIMED
  accrualTxHash  String   @unique
  claimTxHash    String? // NOT unique: one claimReferralReward() call pays out and stamps every still-ACCRUED row at once
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([claimTxHash])
}

model Ticket {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  subject   String
  status    String          @default("OPEN") // OPEN | PENDING | CLOSED
  createdAt DateTime        @default(now())
  messages  TicketMessage[]

  @@index([userId])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  authorRole Role
  body       String
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

/// Tracks the last block processed per contract, for indexer resume.
model IndexerCursor {
  contractAddress String   @id
  lastBlock       BigInt
  updatedAt       DateTime @updatedAt
}
